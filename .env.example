# --- Neo4j (docker-compose usa la misma contraseña) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mnemosine123

# --- LLM para extraer el grafo y responder (Google Gemini) ---
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash

# --- Embeddings locales ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Si Gemini está saturado (503), se cambia de proveedor desde aquí, sin tocar el código ---
# LLM_TIMEOUT_S=60                 # una llamada más lenta se corta y se reintenta
# Ollama (local):  pip install ollama   y   ollama pull <modelo>
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# OLLAMA_HOST=http://localhost:11434
# API compatible con OpenAI (Groq, OpenRouter, ...):  pip install openai
# LLM_PROVIDER=openai
# LLM_MODEL=<modelo del proveedor>
# LLM_BASE_URL=<url base del proveedor>
# LLM_API_KEY=<tu clave>
